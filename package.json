{
  "name": "nextjs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build:furry-history-board",
    "dev": "next dev",
    "prebuild": "npm run build:furry-history-board",
    "build": "next build",
    "build:furry-history-board": "vite build --config labs/furry-history-board/vite.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "generate:portfolio": "tsx scripts/generate-portfolio-content.ts",
    "generate:zoo": "tsx scripts/generate-zoo-collection.ts",
    "generate:zoo-complete-edition": "tsx scripts/generate-zoo-complete-edition.tsx",
    "postmark:test": "tsx scripts/send-test-email.ts",
    "upload:image": "tsx scripts/upload-image.ts",
    "newsletter:post": "tsx scripts/newsletter-post.ts",
    "test": "npm run test:site && npm run test:furry-history-board",
    "test:site": "tsx --test $(find app lib scripts -name '*.test.ts' -print | sort)",
    "test:furry-history-board": "vitest run --config labs/furry-history-board/vitest.config.ts",
    "email:test": "tsx scripts/send-test-email.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/typography": "^0.5.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^18.0.3",
    "feed": "^5.2.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postmark": "^4.0.7",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.4",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^26.0.0",
    "postcss": "^8",
    "sass": "^1.98.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "yaml": "^2.4.2"
  }
}
