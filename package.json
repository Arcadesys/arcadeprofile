{
  "name": "nextjs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build:analytics-manifest && npm run build:furry-history-board",
    "dev": "next dev",
    "prebuild": "npm run build:analytics-manifest && npm run build:furry-history-board",
    "build": "next build",
    "build:furry-history-board": "vite build --config labs/furry-history-board/vite.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "generate:portfolio": "tsx scripts/generate-portfolio-content.ts",
    "generate:zoo": "tsx scripts/generate-zoo-collection.ts",
    "generate:zoo-complete-edition": "tsx scripts/generate-zoo-complete-edition.tsx",
    "postmark:test": "tsx scripts/send-test-email.ts",
    "upload:image": "tsx scripts/upload-image.ts",
    "newsletter:post": "tsx scripts/newsletter-post.ts",
    "test": "npm run test:site && npm run test:furry-history-board",
    "audit:live": "tsx scripts/live-audit.ts",
    "test:seo": "tsx --test scripts/seo-rendered.check.ts",
    "test:site": "tsx --test $(find app lib scripts -name '*.test.ts' -print | sort)",
    "test:furry-history-board": "vitest run --config labs/furry-history-board/vitest.config.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "build:analytics-manifest": "node --import tsx scripts/build-analytics-manifest.ts",
    "sticker-chat:build": "node scripts/build-reaction-stickers-chat-widget.mjs",
    "sticker-chat:serve": "npm run sticker-chat:build && node scripts/reaction-stickers-chat-server.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^18.0.3",
    "feed": "^5.2.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postmark": "^4.0.7",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "postcss": "^8",
    "sass": "^1.105.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.2"
  }
}
