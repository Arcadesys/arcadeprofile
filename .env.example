# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL (used in emails, RSS, unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://www.thearcades.me

# --- Resend Contacts, Topics, and newsletter broadcasts.
RESEND_API_KEY=
RESEND_SEND_API_KEY=
RESEND_FROM_EMAIL=austen@mail.thearcades.me
RESEND_FROM_NAME=The Arcades
RESEND_TOPIC_ALL_WRITING_ID=
RESEND_TOPIC_FICTION_ID=
RESEND_TOPIC_ESSAYS_ID=
RESEND_TOPIC_LAB_ID=
RESEND_TOPIC_QUEER_COLUMNS_ID=
RESEND_TOPIC_WORK_AI_ID=
RESEND_TOPIC_TH4F_ID=
RESEND_SEGMENT_ESSAY_BROADCAST_ID=
CRON_SECRET=

# --- Writing signup verification. Redis holds encrypted pending email/challenge
# records for at most 24 hours; after explicit confirmation, only the Resend contact
# ID and selected topics remain up to 30 days.
# Local/manual names; Vercel Upstash integration KV_REST_API_URL/TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SIGNUP_LINK_SECRET=

# --- Transactional mail uses Resend. There is no provider fallback.
MAIL_PROVIDER=resend
# Disable open/click tracking for the Resend domain in its dashboard.

WRITING_WELCOME_ENABLED=false
WELCOME_SERIES_ENABLED=false

# --- Vercel Blob Storage (Chicago Loves Toons gallery and any blob uploads)
# Generate in Vercel dashboard: Storage → Blob → your store → "Create token"
BLOB_READ_WRITE_TOKEN=
