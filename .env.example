# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL (used in emails, RSS, unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://thearcades.me

# Cron routes (e.g. scheduled publish, email test)
CRON_SECRET=

# --- Payload CMS
PAYLOAD_API_URL=http://localhost:3000
# Generate via Payload admin: Users → pick user → Enable API Key → copy
PAYLOAD_API_KEY=

# MCP HTTP endpoint auth — separate from PAYLOAD_API_KEY so they rotate independently.
# Generate with: openssl rand -hex 32
MCP_API_KEY=
# Optional read-only MCP key. Connectors authed with this key can call list_*
# and get_* tools but not any write tool (create_post, update_post, upload_*,
# repair_post_image_markdown, update_page). Leave blank to disable.
MCP_READ_KEY=

# Database
DATABASE_URI=
# Alias supported by some libraries in this repo
DATABASE_URL=

# --- ActiveCampaign (blog newsletter on first publish — see docs/activecampaign-blog-notifications.md)
# Primary names (used by lib/activecampaign.ts):
AC_API_URL=
AC_API_KEY=
# Audience list ids — set to the AC list ids returned when the lists were created.
# All posts fan out to (Fiction | Essays) + All on publish.
AC_LIST_ID_ALL=
AC_LIST_ID_FICTION=
AC_LIST_ID_ESSAYS=
# Single-recipient list used by the per-post "Send newsletter preview" admin button.
AC_TEST_LIST_ID=
# Verified sender in ActiveCampaign (or rely on POSTMARK_FROM_EMAIL as fallback)
AC_NEWSLETTER_FROM_EMAIL=
AC_NEWSLETTER_FROM_NAME=The Arcades
AC_NEWSLETTER_REPLY_TO=
#
# Legacy / deprecated:
# AC_NEWSLETTER_LIST_ID — superseded by AC_LIST_ID_ALL/FICTION/ESSAYS but still
# read as a fallback by the older sendBlogPostNewsletter() entry-point and tests.
# ACTIVECAMPAIGN_* aliases (same values) are also accepted for back-compat.

# --- Postmark (transactional test route and optional legacy batch code in lib/postmark.ts)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=The Arcades
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound
# Optional safety rail: fail boot in production if token is missing
POSTMARK_REQUIRED_IN_PROD=false
# Optional webhook auth token for /api/postmark/webhook
POSTMARK_WEBHOOK_SECRET=

# --- Vercel Blob Storage (Chicago Loves Toons gallery and any blob uploads)
# Generate in Vercel dashboard: Storage → Blob → your store → "Create token"
BLOB_READ_WRITE_TOKEN=

# --- Social auto-posting (fires from Posts afterChange when a post first
# transitions into a public state — see lib/social/index.ts).
# Each platform is independent: leave creds blank to skip that platform.

# Bluesky (AT Protocol)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Facebook Page (Graph API). Use a long-lived Page Access Token with
# pages_manage_posts + pages_read_engagement.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Optional pin to a specific Graph API version (default: v21.0)
# FACEBOOK_GRAPH_VERSION=v21.0

# Instagram (Graph API, shares the Facebook Page Token above).
# INSTAGRAM_BUSINESS_ACCOUNT_ID is the IG Business Account id linked to the page.
# Note: Instagram requires a hero image — posts without meta.image are skipped.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# LinkedIn (UGC Posts API). Token needs w_member_social or w_organization_social.
# Author URN forms: urn:li:person:{id} or urn:li:organization:{id}
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
