# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL (used in emails, RSS, unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://www.thearcades.me

# Site-local timezone for publish queue labels and preview timestamps.
SITE_TZ=America/Chicago

# Cron routes (e.g. scheduled publish, email test)
CRON_SECRET=
# Optional positive integer cap for one scheduled publish cron run.
SCHEDULED_POSTS_PER_RUN=

# --- Payload CMS
# Reversible blog-source switch. Markdown is the production default and reads
# only validated files under content/posts. Set `payload` for an explicit rollback.
BLOG_SOURCE=markdown
PAYLOAD_API_URL=http://localhost:3000
# Generate via Payload admin: Users → pick user → Enable API Key → copy
PAYLOAD_API_KEY=

# MCP HTTP endpoint auth — separate from PAYLOAD_API_KEY so they rotate independently.
# Generate with: openssl rand -hex 32
#
# Two flavors of each scope (use whichever fits your rotation workflow):
#  - MCP_API_KEY / MCP_READ_KEY        — single key per scope.
#  - MCP_API_KEYS / MCP_READ_KEYS      — comma-separated lists. Set the new
#    key alongside the old, deploy, swap connectors, then drop the old key.
#
# All four vars are honored. Read keys can call list_*/get_* only; write keys
# can call any tool. Leave blank to disable that scope entirely.
MCP_API_KEY=
MCP_API_KEYS=
MCP_READ_KEY=
MCP_READ_KEYS=

# MCP OAuth flow (for claude.ai custom connectors via /api/mcp/authorize).
#  - MCP_AUTHORIZE_PASSWORD            — password gate on the consent screen.
#  - MCP_OAUTH_ALLOWED_REDIRECT_URIS   — comma-separated allowlist of redirect
#    URIs (or bare origins). Loopback (localhost/127.0.0.1) is always allowed;
#    hosted clients (e.g. https://claude.ai/api/mcp/auth_callback) must be listed
#    here or the authorize endpoint rejects the request. Prevents open redirects.
MCP_AUTHORIZE_PASSWORD=
MCP_OAUTH_ALLOWED_REDIRECT_URIS=

# Database
DATABASE_URI=
# Alias supported by some libraries in this repo
DATABASE_URL=

# --- ActiveCampaign (marketing contacts, list membership, and audience targeting)
# Primary names (used by lib/activecampaign.ts):
AC_API_URL=
AC_API_KEY=
# Audience list ids. One per audience (All, Fiction, Essays, Arcades Lab). The
# subscribe API writes membership here; scheduled newsletter sends read active
# recipients from the editorial lists before handing delivery to Postmark. The
# Lab list is an independent preference lane for targeted build-log notices.
AC_LIST_ID_ALL_PERPOST=
AC_LIST_ID_FICTION_PERPOST=
AC_LIST_ID_ESSAYS_PERPOST=
AC_LIST_ID_LAB_PERPOST=
# Optional custom-field IDs for the ActiveCampaign Form 7 wrapper. Leave blank
# until those hidden fields exist in the account; these values are field IDs,
# not credentials or generated form submission tokens.
NEXT_PUBLIC_AC_SOURCE_FIELD_ID=
NEXT_PUBLIC_AC_MAGNET_FIELD_ID=
# ACTIVECAMPAIGN_API_URL / ACTIVECAMPAIGN_API_KEY are accepted as API aliases.

# --- Postmark (transactional tests, per-post newsletters, and delivery webhooks)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=The Arcades
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound
# Optional tracking flags for newsletter sends. Defaults keep the public
# "no tracking pixels" promise: delivery/bounce webhooks work without opens.
POSTMARK_TRACK_OPENS=false
POSTMARK_TRACK_LINKS=None
# Optional safety rail: fail boot in production if token is missing
POSTMARK_REQUIRED_IN_PROD=false
# Webhook auth token for /api/postmark/webhook. REQUIRED for delivery tracking:
# without a registered webhook, delivery/bounce/open counts never update. The
# webhook is per-message-stream and must be registered on the BROADCAST stream.
# Register/verify it idempotently with:
#   npx tsx scripts/postmark-webhook-setup.ts          # register-or-update
#   npx tsx scripts/postmark-webhook-setup.ts --verify  # exit 1 if missing
# It configures the Basic-Auth URL form, e.g.
# https://postmark:${POSTMARK_WEBHOOK_SECRET}@thearcades.me/api/postmark/webhook
POSTMARK_WEBHOOK_SECRET=
# Base URL used by the webhook-setup script (falls back to NEXT_PUBLIC_SITE_URL
# or CRON_TARGET_URL).
WEBHOOK_BASE_URL=

# --- Vercel Blob Storage (Chicago Loves Toons gallery and any blob uploads)
# Generate in Vercel dashboard: Storage → Blob → your store → "Create token"
BLOB_READ_WRITE_TOKEN=
