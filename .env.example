# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL (used in emails, RSS, unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://www.thearcades.me

# --- Kit subscriptions and essay broadcasts. Each audience form must be
# configured for double opt-in. The daily authenticated reconciler adds its
# audience tag only after Kit lists the subscriber as active on that form.
KIT_API_KEY=
KIT_FORM_ALL_ID=9953083
KIT_FORM_FICTION_ID=9953090
KIT_FORM_ESSAYS_ID=9953099
KIT_FORM_LAB_ID=9953112
KIT_TAG_ALL_WRITING_ID=23851250
KIT_TAG_FICTION_ID=23851251
KIT_TAG_ESSAYS_ID=23851252
KIT_TAG_LAB_ID=23851253
CRON_SECRET=
# Leave unset until per-form confirmation is proven for existing active contacts.
KIT_RECONCILE_ENABLED=

# --- Postmark (newsletter previews only)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=The Arcades
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound
# Optional tracking flags for newsletter sends. Defaults keep the public
# "no tracking pixels" promise: delivery/bounce webhooks work without opens.
POSTMARK_TRACK_OPENS=false
POSTMARK_TRACK_LINKS=None

# --- Vercel Blob Storage (Chicago Loves Toons gallery and any blob uploads)
# Generate in Vercel dashboard: Storage → Blob → your store → "Create token"
BLOB_READ_WRITE_TOKEN=
