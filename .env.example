# Copy to .env.local and fill in values. Never commit real secrets.

# Public site URL (used in emails, RSS, unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://www.thearcades.me

# --- Email service (services/email): owns subscriber consent/preferences,
# broadcasts through Kit, delivers transactional mail through Postmark. Not
# yet deployed anywhere — see docs/email-service-migration.md. Until this is
# set, /api/subscribe and `npm run newsletter:post` fail closed.
# EMAIL_SERVICE_SUBSCRIBE_KEY is used by the site's subscribe form;
# EMAIL_SERVICE_ADMIN_KEY is only needed by the newsletter-send/test scripts.
EMAIL_SERVICE_URL=
EMAIL_SERVICE_SUBSCRIBE_KEY=
EMAIL_SERVICE_ADMIN_KEY=

# --- Postmark (transactional tests; services/email also uses its own
# POSTMARK_SERVER_TOKEN/POSTMARK_WEBHOOK_KEY set on that service's host, not here)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_FROM_NAME=The Arcades
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_TRANSACTIONAL_STREAM=outbound
# Optional tracking flags for newsletter sends. Defaults keep the public
# "no tracking pixels" promise: delivery/bounce webhooks work without opens.
POSTMARK_TRACK_OPENS=false
POSTMARK_TRACK_LINKS=None

# --- Vercel Blob Storage (Chicago Loves Toons gallery and any blob uploads)
# Generate in Vercel dashboard: Storage → Blob → your store → "Create token"
BLOB_READ_WRITE_TOKEN=
